{
  "schema_version": 1,
  "base_visual_contract": {
    "object_name": {"required": true, "separate_from_visible_title": true},
    "visible_title": {"text": "", "owner": "widget", "visible": true},
    "hint": {"owner": "widget", "enabled": true, "content": ["business_meaning", "calculation", "limitations"]},
    "tooltip": {"hover_target": "datum", "current_value": true, "unit": true, "missing": "explicit", "zero_denominator": "explicit", "comparison": {"dates": true, "values": true, "absolute_delta": true, "relative_delta": true}},
    "axes_gridlines": {"x_grid": false, "y_grid": false, "zero_baseline": "semantic", "range": "auto", "ticks": "unique_after_formatting"},
    "labels": {"visible": true, "precision": "from_field", "unit": "from_field", "sign": "semantic", "abbreviation": "locale", "collision": "viewport_aware"},
    "legend": {"mode": "dynamic_series", "order": "display_order", "bound_to_visible_series": true},
    "comparison": {"method": "explicit", "alignment": "calendar", "partial_period": "label", "missing": "explicit", "delta_format": "absolute_and_relative", "color": "semantic"},
    "kpi": {"separate_object": false, "value": false, "comparison_label": false, "sparkline": false, "hint": true},
    "table": {"columns": [], "widths": "explicit", "header": "pinned", "raw_and_formatted": true, "sort": "explicit", "pagination": true, "total_position": "bottom", "internal_scroll": true},
    "selector": {"param_name": "", "type": "string", "default": null, "mode": "single", "clear": true, "select_all": false, "reset": false, "consumers": []},
    "geometry": {"width": 12, "height": 8, "spacing": 8, "preserve_manual": true, "narrow_viewport": true, "long_labels": "wrap_or_ellipsis_with_tooltip"},
    "states_theme": {"states": ["loading", "error", "no_data", "business_zero"], "themes": ["light", "dark"], "theme": "auto"}
  },
  "recipes": {
    "kpi_sparkline": {
      "reference_family": "standalone_kpi_with_sparkline",
      "technology": "advanced_chart",
      "object_type": "advanced-chart_node",
      "renderer": "kpi_sparkline_renderer.js",
      "required_bindings": ["metric", "date", "comparison"],
      "visual_contract": {"visible_title": {"owner": "body"}, "legend": {"mode": "hidden"}, "kpi": {"direction": "neutral", "delta_kind": "relative", "value_scale": null, "relative_denominator": "absolute_previous", "separate_object": true, "value": true, "comparison_label": true, "sparkline": true}, "geometry": {"width": 6, "height": 4}, "labels": {"precision": 0}},
      "example": {"data_class": "synthetic", "states": ["value", "loading", "error", "no_data", "business_zero"]}
    },
    "time_comparison": {
      "technology": "wizard",
      "object_type": "wizard_chart",
      "wizard_visualization": "line",
      "required_bindings": ["date", "metric", "comparison"],
      "visual_contract": {"axes_gridlines": {"x_grid": false, "y_grid": true}, "legend": {"mode": "dynamic_series"}, "comparison": {"method": "current_vs_explicit_period"}},
      "example": {"data_class": "synthetic", "states": ["current_and_previous", "partial_period", "missing"]}
    },
    "categorical_bar": {
      "technology": "wizard",
      "object_type": "wizard_chart",
      "wizard_visualization": "bar",
      "required_bindings": ["category", "metric"],
      "visual_contract": {"axes_gridlines": {"x_grid": true, "y_grid": false, "zero_baseline": true}, "labels": {"visible": true, "position": "outside"}, "legend": {"mode": "hidden"}},
      "example": {"data_class": "synthetic", "states": ["positive", "zero", "missing", "long_label"]}
    },
    "comparison_matrix": {
      "reference_family": "multi_level_version_matrix",
      "technology": "advanced_chart",
      "object_type": "advanced-chart_node",
      "renderer": "version_matrix_renderer.js",
      "required_bindings": ["rows", "metric"],
      "visual_contract": {"legend": {"mode": "fixed_semantic", "items": [{"status": "noChange", "label": "No change"}, {"status": "hwChange", "label": "Hardware change"}, {"status": "swChange", "label": "Software change"}, {"status": "blChange", "label": "Bootloader change"}, {"status": "missing", "label": "Missing"}, {"status": "manual_not_applicable", "label": "Manual N/A"}]}, "table": {"total_position": "none", "header_rows": ["RELEASE SCOPE", "RELEASE TARGET", "CI / IS", "RELEASE STATUS", "FOR ASSEMBLY", "VERSION TYPE"], "first_column_label": "Item", "first_column_width": 150, "value_column_width": 112, "header_height": 32, "header_heights": [32, 32, 48, 36, 36, 38]}, "geometry": {"width": 12, "height": 10}},
      "example": {"data_class": "synthetic", "states": ["increase", "unchanged", "decrease", "missing"]}
    },
    "cross_tab_totals": {
      "technology": "wizard",
      "object_type": "wizard_chart",
      "wizard_visualization": "pivot_table",
      "required_bindings": ["rows", "columns", "measures"],
      "visual_contract": {"table": {"total_position": "bottom_and_right", "pagination": true}, "legend": {"mode": "hidden"}},
      "example": {"data_class": "synthetic", "states": ["detail", "subtotal", "grand_total"]}
    },
    "weekly_totals_table": {
      "reference_family": "iso_week_totals_table",
      "technology": "advanced_chart",
      "object_type": "advanced-chart_node",
      "renderer": "weekly_totals_renderer.js",
      "required_bindings": ["group", "date", "metric"],
      "visual_contract": {"visible_title": {"owner": "body"}, "legend": {"mode": "hidden"}, "table": {"total_position": "bottom_and_right", "first_column_label": "Group", "widths": {"first": 132, "period": 82, "total": 96}, "header": "pinned", "internal_scroll": true}, "geometry": {"width": 12, "height": 10, "preserve_manual": true}},
      "example": {"data_class": "synthetic", "states": ["iso_weeks", "empty", "bottom_total", "right_total"]}
    },
    "native_detail_table": {
      "technology": "wizard",
      "object_type": "wizard_chart",
      "wizard_visualization": "flat_table",
      "required_bindings": ["columns"],
      "visual_contract": {"table": {"total_position": "bottom", "header": "pinned", "pagination": true, "internal_scroll": true}, "legend": {"mode": "hidden"}},
      "example": {"data_class": "synthetic", "states": ["rows", "empty", "long_text", "pagination"]}
    },
    "selector": {
      "technology": "selector",
      "object_type": "control_node",
      "renderer": "selector_renderer.js",
      "required_bindings": ["parameter", "consumers"],
      "visual_contract": {"visible_title": {"owner": "widget"}, "hint": {"enabled": false}, "labels": {"visible": false}, "legend": {"mode": "hidden"}, "geometry": {"width": 4, "height": 2}},
      "example": {"data_class": "synthetic", "states": ["default", "selected", "cleared", "no_options"]}
    },
    "period_series": {
      "reference_family": "period_aligned_line_bar",
      "technology": "advanced_chart",
      "object_type": "advanced-chart_node",
      "renderer": "period_series_renderer.js",
      "required_bindings": ["metric", "date", "comparison"],
      "visual_contract": {"visible_title": {"owner": "body"}, "legend": {"mode": "fixed_semantic"}, "geometry": {"width": 24, "height": 12, "preserve_manual": true}},
      "example": {"data_class": "synthetic", "states": ["current", "comparison", "missing_point", "no_data"]}
    }
  }
}
