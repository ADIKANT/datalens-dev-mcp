{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/browser-policy.schema.json",
  "title": "DataLens browser policy",
  "type": "object",
  "required": ["mode", "source", "applicability", "purpose", "read_only", "mutation_allowed", "earliest_stage", "calls_before_earliest_stage_allowed", "allowed_interactions", "target"],
  "properties": {
    "mode": {"enum": ["forbidden", "optional", "required"]},
    "source": {"enum": ["explicit_user", "compiled_default", "workspace_policy"]},
    "applicability": {"enum": ["applicable", "not_applicable"]},
    "purpose": {"type": "string", "minLength": 1},
    "read_only": {"const": true},
    "mutation_allowed": {"const": false},
    "earliest_stage": {"type": "string", "minLength": 1},
    "calls_before_earliest_stage_allowed": {"type": "boolean"},
    "allowed_interactions": {"type": "array", "uniqueItems": true, "items": {"enum": ["activate_tab", "scroll", "hover_visual_detail", "read_only_error_detail"]}},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "contract_revision", "plan_hash", "candidate_build_identity", "workbook_id", "dashboard_id", "saved_revision", "published_revision", "canonical_url"],
      "properties": {
        "task_id": {"type": "string"},
        "contract_revision": {"type": "integer", "minimum": 0},
        "plan_hash": {"type": "string"},
        "candidate_build_identity": {"type": "string"},
        "workbook_id": {"type": "string"},
        "dashboard_id": {"type": "string"},
        "saved_revision": {"type": "string"},
        "published_revision": {"type": "string"},
        "canonical_url": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
