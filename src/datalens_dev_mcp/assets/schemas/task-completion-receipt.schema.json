{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/task-completion-receipt.schema.json",
  "type": "object",
  "required": ["ok", "state", "highest_proof_level", "required_evidence", "satisfied_evidence", "missing_evidence", "limitations"],
  "properties": {
    "ok": {"type": "boolean"},
    "state": {"type": "string"},
    "highest_proof_level": {"type": "string"},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "satisfied_evidence": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
