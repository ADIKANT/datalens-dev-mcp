{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/data-assertion-spec.schema.json",
  "title": "Typed Data Assertion Specification",
  "type": "object",
  "additionalProperties": true,
  "required": ["dataset_id", "columns", "assertions"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "workbook_id": {"type": "string"},
    "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "filters": {"type": "array", "items": {"type": "object"}},
    "params": {"type": "array", "items": {"type": "object"}},
    "sort": {"type": "array", "items": {"type": "object", "required": ["guid", "direction"]}},
    "tie_breaker_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "sample": {
      "type": "object",
      "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 100000}, "max_pages": {"type": "integer", "minimum": 1, "maximum": 100}}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["schema_matches", "not_empty", "expected_empty", "row_count_between", "unique_key", "no_nulls", "null_ratio_between", "value_domain", "min_max_date", "date_coverage", "numeric_range", "non_negative", "ratio_consistency", "comparison_period_alignment", "pagination_complete", "selector_value_available", "selector_empty_means_no_filter", "sort_total_order"]
          }
        }
      }
    }
  }
}
