{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/dataset-preview-request.schema.json",
  "title": "Typed dataset preview request",
  "type": "object",
  "required": ["dataset_id", "columns"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "workbook_id": {"type": "string"},
    "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "filters": {"type": "array", "items": {"type": "object"}},
    "params": {"type": "array", "items": {"type": "object"}},
    "sort": {"type": "array", "items": {"type": "object"}},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 100},
    "offset": {"type": "integer", "minimum": 0, "default": 0},
    "max_pages": {"type": "integer", "minimum": 1, "maximum": 100, "default": 1},
    "tie_breaker_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
