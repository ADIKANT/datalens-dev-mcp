{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/task-data-proof-receipt.schema.json",
  "title": "Fresh typed data proof receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_version", "task_id", "contract_hash", "target_binding_hash", "planning_profile_hash", "planning_query_set_hash", "assertion_plan_hash", "schema_hash", "observed_at", "fresh", "proof_level", "fallback_kind", "live_data_verified", "dataset_data_semantics", "api_first_diagnostics", "status", "assertions", "provider_calls", "row_count", "paging", "unexpected_empty_diagnostics", "limitations", "raw_rows_inline", "receipt_hash"],
  "properties": {
    "schema_id": {"const": "task_data_proof_receipt"},
    "receipt_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_binding_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planning_profile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planning_query_set_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assertion_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_at": {"type": "string", "minLength": 1},
    "fresh": {"const": true},
    "proof_level": {"enum": ["source_static", "live_read_only_api"]},
    "fallback_kind": {"type": "string"},
    "live_data_verified": {"type": "boolean"},
    "dataset_data_semantics": {"const": "unknown_experimental"},
    "api_first_diagnostics": {"type": "object"},
    "status": {"enum": ["passed", "failed", "blocked", "insufficient_evidence"]},
    "assertions": {"type": "array", "items": {"type": "object"}},
    "provider_calls": {"type": "array", "items": {"type": "object"}},
    "row_count": {"type": "integer", "minimum": 0},
    "paging": {"type": "object"},
    "unexpected_empty_diagnostics": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "raw_rows_inline": {"const": false},
    "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
