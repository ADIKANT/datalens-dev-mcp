{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": true,
      "description": "Ссылки DataLens Editor; меняйте placeholders.",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "type": "array"
      },
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "description": "Числовая сумма для форматирования",
            "examples": [
              1250.5
            ],
            "type": [
              "number",
              "null"
            ]
          },
          "entity_id": {
            "description": "Стабильный идентификатор строки",
            "examples": [
              "OBJ-1042"
            ],
            "type": "string"
          },
          "entity_name": {
            "description": "Название объекта",
            "examples": [
              "Объект 1042"
            ],
            "type": "string"
          },
          "owner": {
            "description": "Ответственный владелец",
            "examples": [
              "Команда A"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "Технический ключ состояния",
            "examples": [
              "ready"
            ],
            "type": "string"
          },
          "updated_at": {
            "description": "Время последнего изменения",
            "examples": [
              "2026-01-05T12:30:00Z"
            ],
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entity_id",
          "entity_name",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rows",
    "meta",
    "params"
  ],
  "title": "Широкая детальная таблица",
  "type": "object"
}
