{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": true,
      "description": "DataLens Editor links; replace placeholders.",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "type": "array"
      },
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "details_url": {
            "description": "Safe details link",
            "examples": [
              "https://example.invalid/item/1042"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "entity_id": {
            "description": "Stable row identifier",
            "examples": [
              "OBJ-1042"
            ],
            "type": "string"
          },
          "item": {
            "description": "Primary row label",
            "examples": [
              "Example row"
            ],
            "type": "string"
          },
          "status": {
            "description": "Technical status key",
            "examples": [
              "ready"
            ],
            "type": "string"
          },
          "updated_at": {
            "description": "Last update time",
            "examples": [
              "2026-01-05T12:30:00Z"
            ],
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entity_id",
          "item",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rows",
    "meta",
    "params"
  ],
  "title": "Status table",
  "type": "object"
}
