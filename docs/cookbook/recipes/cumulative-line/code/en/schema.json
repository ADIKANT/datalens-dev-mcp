{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": true,
      "description": "DataLens Editor links; replace placeholders.",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "type": "array"
      },
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "description": "Start of the displayed time interval after grouping, such as a day, week, or month. Values must sort chronologically.",
            "examples": [
              "2026-01-01"
            ],
            "type": "string"
          },
          "increment": {
            "description": "Change within the time interval that Prepare adds to the running total",
            "examples": [
              12
            ],
            "type": "number"
          }
        },
        "required": [
          "bucket",
          "increment"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rows",
    "meta",
    "params"
  ],
  "title": "Cumulative line",
  "type": "object"
}
