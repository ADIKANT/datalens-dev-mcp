{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": true,
      "description": "Ссылки DataLens Editor; меняйте placeholders.",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "type": "array"
      },
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "description": "Категория верхнего уровня",
            "examples": [
              "Группа A"
            ],
            "type": "string"
          },
          "completed": {
            "description": "Выполненная часть",
            "examples": [
              72
            ],
            "type": "number"
          },
          "total": {
            "description": "Общий объём для progress",
            "examples": [
              100
            ],
            "type": "number"
          }
        },
        "required": [
          "category",
          "completed",
          "total"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rows",
    "meta",
    "params"
  ],
  "title": "Сгруппированная сводная таблица",
  "type": "object"
}
