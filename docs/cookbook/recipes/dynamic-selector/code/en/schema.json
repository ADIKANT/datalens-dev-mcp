{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": true,
      "description": "DataLens Editor links; replace placeholders.",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "type": "array"
      },
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "title": {
            "description": "Displayed option label",
            "examples": [
              "Segment A"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "description": "Stable option value written to Params",
            "examples": [
              "segment_a"
            ],
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rows",
    "meta",
    "params"
  ],
  "title": "Dynamic selector",
  "type": "object"
}
