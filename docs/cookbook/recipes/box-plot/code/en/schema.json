{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": true,
      "description": "DataLens Editor links; replace placeholders.",
      "type": "object"
    },
    "params": {
      "additionalProperties": {
        "type": "array"
      },
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "description": "Displayed category",
            "examples": [
              "Category A"
            ],
            "type": "string"
          },
          "max": {
            "description": "Distribution maximum",
            "examples": [
              63
            ],
            "type": "number"
          },
          "median": {
            "description": "Median",
            "examples": [
              31
            ],
            "type": "number"
          },
          "min": {
            "description": "Distribution minimum",
            "examples": [
              10
            ],
            "type": "number"
          },
          "q1": {
            "description": "First quartile",
            "examples": [
              22
            ],
            "type": "number"
          },
          "q3": {
            "description": "Third quartile",
            "examples": [
              44
            ],
            "type": "number"
          },
          "size": {
            "description": "Relative bubble area",
            "examples": [
              34
            ],
            "type": "number"
          },
          "value": {
            "description": "Numeric mark value",
            "examples": [
              42
            ],
            "type": [
              "number",
              "null"
            ]
          },
          "x": {
            "description": "Horizontal-axis coordinate",
            "examples": [
              24
            ],
            "type": "number"
          },
          "y": {
            "description": "Vertical-axis coordinate",
            "examples": [
              68
            ],
            "type": "number"
          }
        },
        "required": [
          "label",
          "x",
          "y",
          "size",
          "min",
          "q1",
          "median",
          "q3",
          "max"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rows",
    "meta",
    "params"
  ],
  "title": "Box plot",
  "type": "object"
}
