{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/task-data-proof-plan.schema.json",
  "title": "Fresh typed data proof plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "spec_version", "task_id", "contract_hash", "target_binding_hash", "planning_profile_hash", "planning_query_set_hash", "planning_schema_hash", "dataset_id", "workbook_id", "columns", "filters", "params", "sort", "tie_breaker_fields", "sample", "budget", "assertions", "dataset_data_semantics", "fresh_required", "issues", "plan_hash", "ok", "status"],
  "properties": {
    "schema_id": {"const": "task_data_proof_plan"},
    "spec_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_binding_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planning_profile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planning_query_set_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planning_schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "workbook_id": {"type": "string"},
    "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "filters": {"type": "array", "items": {"type": "object"}},
    "params": {"type": "array", "items": {"type": "object"}},
    "sort": {"type": "array", "items": {"type": "object"}},
    "tie_breaker_fields": {"type": "array", "items": {"type": "string"}},
    "sample": {"type": "object"},
    "budget": {"type": "object"},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "dataset_data_semantics": {"const": "unknown_experimental"},
    "fresh_required": {"const": true},
    "issues": {"type": "array", "items": {"type": "string"}},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ok": {"const": true},
    "status": {"const": "ready"}
  }
}
