{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/publish-stage-receipt.schema.json",
  "title": "Autonomous publish-from-saved stage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_version", "observed_at", "task_id", "contract_hash", "contract_revision", "scope_revision", "authorization_revision", "phase", "plan_hash", "object_id", "expected_provider_revision", "attempt_id", "idempotency_key", "dispatched_at", "resolved_at", "attempts", "saved_readback_hash", "publish_plan_hash", "action_ids", "provider_request_hashes", "expected_pre_write_revisions", "returned_revisions", "object_statuses", "write_count", "ambiguity_state", "status", "receipt_hash"],
  "properties": {
    "schema_id": {"const": "datalens_publish_stage_receipt"},
    "receipt_version": {"const": 2},
    "observed_at": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_revision": {"type": "integer", "minimum": 1},
    "scope_revision": {"type": "integer", "minimum": 1},
    "authorization_revision": {"type": "integer", "minimum": 1},
    "phase": {"const": "publish"},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "object_id": {"type": "string", "minLength": 1},
    "expected_provider_revision": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dispatched_at": {"type": "string", "minLength": 1},
    "resolved_at": {"type": "string", "minLength": 1},
    "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
    "saved_readback_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publish_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "minItems": 1, "uniqueItems": true},
    "provider_request_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "expected_pre_write_revisions": {"type": "array", "items": {"type": "string"}},
    "returned_revisions": {"type": "array", "items": {"type": "string"}},
    "object_statuses": {"type": "array", "items": {"type": "object"}},
    "write_count": {"type": "integer", "minimum": 0},
    "ambiguity_state": {"type": "string"},
    "status": {"enum": ["success", "ambiguous", "conflict", "blocked", "failed"]},
    "safe_apply_result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason": {"type": "string"},
    "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "expected_provider_revision", "attempt_id", "idempotency_key", "dispatched_at", "resolved_at", "status"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "expected_provider_revision": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "dispatched_at": {"type": "string", "minLength": 1},
        "resolved_at": {"type": "string", "minLength": 1},
        "status": {"const": "resolved"}
      }
    }
  }
}
