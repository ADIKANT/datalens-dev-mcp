{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/published-readback-receipt.schema.json",
  "title": "Independent published branch readback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_version", "observed_at", "task_id", "contract_hash", "publish_receipt_hash", "branch", "objects", "provider_calls", "all_objects_match", "reconciliation", "status", "receipt_hash"],
  "properties": {
    "schema_id": {"const": "datalens_published_readback_receipt"},
    "receipt_version": {"const": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publish_receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "branch": {"const": "published"},
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/object"}},
    "provider_calls": {"type": "array", "items": {"type": "object"}},
    "all_objects_match": {"type": "boolean"},
    "reconciliation": {"type": "boolean"},
    "status": {"enum": ["success", "mismatch"]},
    "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_type", "revision", "saved_id", "payload_hash", "semantic_match", "complete", "diff_paths"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "object_type": {"type": "string"},
        "revision": {"type": "string"},
        "saved_id": {"type": "string"},
        "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "semantic_match": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "publishable": {"type": "boolean"},
        "diff_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
