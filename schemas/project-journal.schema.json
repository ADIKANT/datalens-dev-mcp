{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datalens-dev-mcp.local/project-journal.schema.json",
  "title": "Persisted DataLens project task journal",
  "type": "object",
  "required": ["task_id", "identity", "build_identity", "target_binding", "contract", "state", "events"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "identity": {"type": "object"},
    "build_identity": {"$ref": "build-identity.schema.json"},
    "target_binding": {"$ref": "target-binding.schema.json"},
    "contract": {"$ref": "task-contract.schema.json"},
    "state": {"$ref": "workflow-state.schema.json"},
    "events": {"type": "array", "items": {"$ref": "workflow-event.schema.json"}},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "save": {"$ref": "save-stage-receipt.schema.json"},
        "saved_readback": {"$ref": "saved-readback-receipt.schema.json"},
        "publish": {"$ref": "publish-stage-receipt.schema.json"},
        "published_readback": {"$ref": "published-readback-receipt.schema.json"}
      }
    }
  },
  "additionalProperties": false
}
