{
  "auth_headers": {
    "Authorization": "Bearer <IAM_TOKEN>",
    "accept": "application/json",
    "content-type": "application/json",
    "x-dl-api-version": "2",
    "x-dl-org-id": "<ORG_ID>"
  },
  "plan_only": {
    "updateConnection": {
      "connectionId": "<CONNECTION_ID>",
      "data": {
        "type": "clickhouse"
      }
    },
    "updateDashboard_save": {
      "entry": {
        "entryId": "<DASHBOARD_ID>",
        "revId": "<REV_ID>"
      },
      "mode": "save"
    },
    "updateDataset": {
      "data": {
        "dataset": {}
      },
      "datasetId": "<DATASET_ID>"
    },
    "updateHtmlPage_publish": {
      "entryId": "<HTML_PAGE_ID>",
      "mode": "publish",
      "revId": "<REV_ID>"
    },
    "updateHtmlPage_save": {
      "content": "<!doctype html><html><head><meta charset=\"utf-8\"></head><body></body></html>",
      "entryId": "<HTML_PAGE_ID>",
      "mode": "save"
    },
    "validateDataset": {
      "data": {
        "dataset": {}
      },
      "datasetId": "<DATASET_ID>",
      "workbookId": "<WORKBOOK_ID>"
    }
  },
  "readonly": {
    "getDashboard": {
      "branch": "saved",
      "dashboardId": "<DASHBOARD_ID>"
    },
    "getEntriesRelations": {
      "entryIds": [
        "<ENTRY_ID>"
      ]
    },
    "getHtmlPage": {
      "branch": "saved",
      "entryId": "<HTML_PAGE_ID>"
    },
    "getWorkbookEntries": {
      "workbookId": "<WORKBOOK_ID>"
    }
  }
}
